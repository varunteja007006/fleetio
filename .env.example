# Convex deployment name (run `npx convex dev` to get yours)
CONVEX_DEPLOYMENT=

# Convex backend URLs (shown after `npx convex dev`)
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=

# Better Auth secret (generate with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Email domain for org email/password sign-up
EMAIL_DOMAIN=

# Google Maps API key for react-native-maps on Android
# Get one at https://console.cloud.google.com/apis/credentials
# Enable "Maps SDK for Android" in your GCP project
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
